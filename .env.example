# Environment Variables — HubReminder
# Salin file ini menjadi .env.local dan isi nilainya. Jangan commit nilai asli.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Enkripsi sesi dan refresh token MagangHub (32 karakter acak, server only)
SESSION_ENCRYPTION_KEY=your-32-character-encryption-key

# Endpoint inisiasi SSO pada API Monev (GET). Jangan isi URL halaman account.kemnaker.go.id.
# Default: /auth/login jika variabel ini tidak diatur.
MAGANGHUB_LOGIN_PATH=/auth/login

# VAPID Keys untuk Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Reminder grup WhatsApp via Fonnte (server only)
FOONTE_API_TOKEN=your-foonte-token
# ID grup WhatsApp target, contoh: 120363012345678901@g.us
# JANGAN pakai link undangan (https://chat.whatsapp.com/...) — API menolak.
FOONTE_WA_GROUP_ID=your-group-id@g.us
# Optional: multiple Foonte targets (numbers or group IDs), comma separated. Falls back to FOONTE_WA_GROUP_ID.
# FOONTE_WA_TARGETS=6281234567890,120363012345678901@g.us

# Email admin (pisahkan dengan koma) yang boleh mengubah mode/jadwal/target reminder global.
REMINDER_ADMIN_EMAILS=admin@yourdomain.com

# Header X-Cron-Secret yang dikirim oleh cron-job.org (server only)
CRON_SECRET_KEY=replace-with-a-long-random-secret

# REST API cron-job.org (server only). Ambil API key di Console > Settings.
CRON_JOB_ORG_API_KEY=your-cron-job-org-api-key
# Isi setelah job pertama dibuat oleh endpoint /api/cron/reminder/configure.
# CRON_JOB_ORG_JOB_ID=12345678
# Job checker status laporan, juga dikembalikan oleh endpoint configure.
# CRON_JOB_ORG_ATTENDANCE_JOB_ID=12345679

# URL publik aplikasi, tanpa garis miring terakhir.
APP_URL=https://your-domain.com
# Zona waktu untuk job cron-job.org (zona waktu IANA).
CRON_REMINDER_TIMEZONE=Asia/Jakarta

# Gemini AI untuk auto-generate laporan magang (server only)
GEMINI_API_KEY=your-gemini-api-key
# Model Gemini yang digunakan (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
